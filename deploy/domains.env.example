# 复制为 deploy/domains.env 后再启动 Docker。改域名只改这一份。
# 主机名用逗号分隔，不要写 https://。API 主机不要和官网主机重复。

# 官网。裸域放在 APEX_HOSTS，会跳到同名的 www。
SITE_HOSTS=www.keep-password.work,keep-password.work
APEX_HOSTS=keep-password.work
CANONICAL_HOST=www.keep-password.work

# 客户端和同步。过渡期把旧 API 主机加在后面，两个同时反代，旧客户端不用改。
API_HOSTS=api.keep-password.work

# false：多个官网域名各自可用，裸域只跳到自己的 www。
# true：除 CANONICAL_HOST 以外的官网主机全部跳到规范域名（换域名收尾时再开）。API 主机不跳转。
REDIRECT_TO_CANONICAL=false

PUBLIC_BASE_URL=https://www.keep-password.work
TRUST_PROXY=true

# 换域名过渡期示例（替换上面的值，不要两套同时写）：
# SITE_HOSTS=www.keep-password.work,keep-password.work,www.new-example.com,new-example.com
# APEX_HOSTS=keep-password.work,new-example.com
# API_HOSTS=api.keep-password.work,api.new-example.com
# CANONICAL_HOST=www.new-example.com
# PUBLIC_BASE_URL=https://www.new-example.com
# REDIRECT_TO_CANONICAL=false
