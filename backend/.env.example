FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/keep_password.db
# 本地开发用。生产域名写在 deploy/domains.env，不要在这里列官网主机。
PUBLIC_BASE_URL=http://127.0.0.1:5000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VAULT_STORAGE_DIR=./data/vaults
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
# 开发环境可把验证码打印到日志，无需真实 SMTP
MAIL_DEV_CONSOLE=true
MAX_VAULT_BYTES=16777216
# 生产环境在 Caddy 后部署时设为 true
TRUST_PROXY=false
EMAIL_CODE_MAX_ATTEMPTS=5
