FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/keep_password.db
# 本地开发用。生产域名写在 deploy/domains.env，不要在这里列官网主机。
PUBLIC_BASE_URL=http://127.0.0.1:5000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VAULT_STORAGE_DIR=./data/vaults
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# 开发环境可把验证码打印到日志，无需真实 SMTP，也不要求填写授权码。
MAIL_DEV_CONSOLE=true
MAX_VAULT_BYTES=16777216
# 生产环境在 Caddy 后部署时设为 true
TRUST_PROXY=false
EMAIL_CODE_MAX_ATTEMPTS=5
# 非秘密应用配置：Edge 加载项详情页。前端 JS/文档不含此 URL；Caddy 已把 /api/* 交给应用。
EDGE_STORE_URL=https://microsoftedge.microsoft.com/addons/detail/lbkhkkkmnbhnnmimhadmjappokdfkpgd

# ----- 生产发信（只写在服务器 backend/.env，不要提交真实授权码）-----
# 可用 163 等第三方邮箱替代旧的阿里云 DirectMail。源码默认不要求 SMTP 密钥。
# 已有约定：端口 587 + SMTP_USE_TLS=true（STARTTLS）。代码不会按端口自动改 TLS 模式。
# 163 常见组合需在服务器上实测后再定，例如：
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#   SMTP_USERNAME=your_account@163.com
#   SMTP_PASSWORD=        # 163 客户端授权码，不是登录密码
#   SMTP_FROM=your_account@163.com
#   MAIL_DEV_CONSOLE=false
# 若 587 STARTTLS 不通，可改测 465 + SMTP_USE_SSL=true + SMTP_USE_TLS=false。
# 只要设置了 SMTP_HOST 就会真实发信；失败会返回错误，不会伪装成功。
